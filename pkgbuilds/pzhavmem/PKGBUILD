# Maintainer: dispaly
pkgname=pzhavmem
pkgver=1.0
pkgrel=1
pkgdesc="Случайные мемы в терминале, меняются каждые 2-3 секунды (PzhavOS)"
arch=('any')
url="https://github.com/dispaly/pzhavos"
license=('LicenseRef-pzhavmem')
depends=('bash' 'chafa' 'ncurses')
source=(
  'pzhavmem'
  'za.png'
  'he.png'
  'ci.png'
  'ha.png'
  'nyam.png'
)
sha256sums=('40c430fc88cd3d51408cd265f54d222c49cdb93544d14707c938ad2fb3081964'
            '9df1eb925b6303765d359bfeddb5d99708482de97d71aefbf6322dcb9280ce2c'
            '314549b862d39985beac7ac82b147a61c08a4b2265661a75a50b4c6769d67d22'
            '172057851689f481dca8c0964b7fe103990de9b93684c535be273364c0646ef2'
            '526ca687da4f840fe4fecd49a45fa71455601b217195e928636374431e9aa330'
            '52ddc333785ae61ec2fb813a892688b1cf0e699263278df8ea9132ef2d09c4d4')

package() {
  install -Dm755 "$srcdir/pzhavmem" "$pkgdir/usr/bin/pzhavmem"
  install -Dm644 "$srcdir"/*.png -t "$pkgdir/usr/share/$pkgname/"

  install -Dm644 /dev/stdin "$pkgdir/usr/share/licenses/$pkgname/LICENSE" << 'END'
pzhavmem
========

Скрипт /usr/bin/pzhavmem: делайте с ним что хотите, без ограничений.

Картинки в /usr/share/pzhavmem/: кадры из чужого видео, права принадлежат
их владельцам. Включены для личного использования. Не распространять
отдельно от этого пакета.
END
}
