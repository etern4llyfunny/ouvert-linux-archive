pkgname=ouvert-keyring
pkgver=20261111
pkgrel=1
pkgdesc='Ouvert Linux PGP keyring'
arch=('any')
url='https://github.com/etern4llyfunny/ouvert-repo'
license=('GPL-3.0-or-later')
install=ouvert-keyring.install
source=('ouvert.gpg' 'ouvert-trusted' 'ouvert-revoked')
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm644 -t "$pkgdir/usr/share/pacman/keyrings" ouvert.gpg ouvert-trusted ouvert-revoked
}
