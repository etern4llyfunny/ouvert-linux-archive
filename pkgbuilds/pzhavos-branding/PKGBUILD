# Maintainer: dispaly
pkgname=pzhavos-branding
pkgver=1.0
pkgrel=6
pkgdesc="Оформление PzhavOS: обои, логотип, конфиг fastfetch, памятка zapret2"
arch=('any')
url="https://example.com/pzhavos"
license=('LicenseRef-PzhavOS')
depends=('fastfetch' 'bash')
# chafa нужен только для генерации fastfetch-logo.ansi (делается заранее),
# в рантайме лого статичен, поэтому в depends его нет.
source=('pzhav.png'
        'PzhavOSwalp.png'
        'PzhavOSwalp2.png'
        'PzhavOSwalp3.png'
        'pzhav-kde.png'
        'pzhavos-logo.png'
        'grub-bg.png'
        'fastfetch-logo.ansi'
        'fastfetch-logo-ascii.txt'
        'fastfetch-config.jsonc'
        'README-zapret2.txt'
        'pzhavos-wallpapers.hook'
        'pzhavos-restore-wallpapers.sh'
        'pzhav-cosmic.png'
        'cosmic-bg-all'
        'cosmic-bg-backgrounds'
        'LICENSE')
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

package() {
    # Обои (все 4: pzhav — дефолт, walp1-3 — запас, лежат в системе)
    install -Dm644 "$srcdir/pzhav.png"        "$pkgdir/usr/share/wallpapers/PzhavOS/pzhav.png"
    install -Dm644 "$srcdir/PzhavOSwalp.png"  "$pkgdir/usr/share/wallpapers/PzhavOS/PzhavOSwalp.png"
    install -Dm644 "$srcdir/PzhavOSwalp2.png" "$pkgdir/usr/share/wallpapers/PzhavOS/PzhavOSwalp2.png"
    install -Dm644 "$srcdir/PzhavOSwalp3.png" "$pkgdir/usr/share/wallpapers/PzhavOS/PzhavOSwalp3.png"
    install -Dm644 "$srcdir/pzhav-kde.png"    "$pkgdir/usr/share/wallpapers/PzhavOS/pzhav-kde.png"
    # Bug 47 cosmic: обои COSMIC
    install -Dm644 "$srcdir/pzhav-cosmic.png" "$pkgdir/usr/share/wallpapers/PzhavOS/pzhav-cosmic.png"

    # Логотип дистрибутива (для LOGO= в os-release и общего использования)
    install -Dm644 "$srcdir/pzhavos-logo.png" "$pkgdir/usr/share/pixmaps/pzhavos.png"

    # Ресурсы, на которые ссылаются custom_commands / fastfetch
    install -Dm644 "$srcdir/grub-bg.png"              "$pkgdir/usr/share/pzhavos/grub-bg.png"
    install -Dm644 "$srcdir/fastfetch-logo.ansi"      "$pkgdir/usr/share/pzhavos/fastfetch-logo.ansi"
    install -Dm644 "$srcdir/fastfetch-logo-ascii.txt" "$pkgdir/usr/share/pzhavos/fastfetch-logo-ascii.txt"

    # Конфиг fastfetch для будущих пользователей (новый юзер копирует /etc/skel)
    install -Dm644 "$srcdir/fastfetch-config.jsonc" "$pkgdir/etc/skel/.config/fastfetch/config.jsonc"

    # Bug 47 cosmic: штатный оверрайд cosmic-config.
    # Системный дефолт лежит в /usr/share/cosmic/ и принадлежит пакету
    # cosmic-bg — писать туда НЕЛЬЗЯ (конфликт файлов в pacman и
    # перезапись при -Syu). Пользовательский слой ~/.config/cosmic/
    # ничей, поэтому кладём в /etc/skel. Хук restore-wallpapers.sh
    # здесь не нужен: чужих файлов не трогаем, восстанавливать нечего.
    install -Dm644 "$srcdir/cosmic-bg-all" "$pkgdir/etc/skel/.config/cosmic/com.system76.CosmicBackground/v1/all"
    install -Dm644 "$srcdir/cosmic-bg-backgrounds" "$pkgdir/etc/skel/.config/cosmic/com.system76.CosmicBackground/v1/backgrounds"

    # Памятка zapret2 (в домашнюю папку нового пользователя)
    install -Dm644 "$srcdir/README-zapret2.txt" "$pkgdir/etc/skel/README-zapret2.txt"
    # pacman-хук: обновление xfdesktop / plasma-workspace-wallpapers
    # затирает наши обои штатными. Триггер ПО ПУТЯМ, а не по имени
    # пакета: имена в Arch переезжают, путь — нет.
    install -Dm644 "$srcdir/pzhavos-wallpapers.hook" "$pkgdir/usr/share/libalpm/hooks/pzhavos-wallpapers.hook"
    install -Dm755 "$srcdir/pzhavos-restore-wallpapers.sh" "$pkgdir/usr/share/pzhavos/restore-wallpapers.sh"
    # Текст лицензии: license=(LicenseRef-*) обязывает положить
    # файл в /usr/share/licenses/$pkgname/ — иначе namcap даёт E.
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
