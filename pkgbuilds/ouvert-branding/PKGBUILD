# Maintainer: dispaly
pkgname=ouvert-branding
pkgver=1.0
pkgrel=6
pkgdesc="Оформление Ouvert Linux: обои, логотип, конфиг fastfetch"
arch=('any')
url="https://example.com/ouvert"
license=('LicenseRef-Ouvert Linux')
depends=('fastfetch' 'bash')
# chafa нужен только для генерации fastfetch-logo.ansi (делается заранее),
# в рантайме лого статичен, поэтому в depends его нет.
source=('ouvert.png'
        'ouvert-walp.png'
        'ouvert-walp2.png'
        'ouvert-walp3.png'
        'ouvert-kde.png'
        'ouvert-logo.png'
        'grub-bg.png'
        'fastfetch-logo.ansi'
        'fastfetch-logo-ascii.txt'
        'fastfetch-config.jsonc'
        'ouvert-wallpapers.hook'
        'ouvert-restore-wallpapers.sh'
        'ouvert-cosmic.png'
        'cosmic-bg-all'
        'cosmic-bg-backgrounds'
        'LICENSE')
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

package() {
    # Обои (все 4: ouvert — дефолт, walp1-3 — запас, лежат в системе)
    install -Dm644 "$srcdir/ouvert.png"        "$pkgdir/usr/share/wallpapers/Ouvert/ouvert.png"
    install -Dm644 "$srcdir/ouvert-walp.png"  "$pkgdir/usr/share/wallpapers/Ouvert/ouvert-walp.png"
    install -Dm644 "$srcdir/ouvert-walp2.png" "$pkgdir/usr/share/wallpapers/Ouvert/ouvert-walp2.png"
    install -Dm644 "$srcdir/ouvert-walp3.png" "$pkgdir/usr/share/wallpapers/Ouvert/ouvert-walp3.png"
    install -Dm644 "$srcdir/ouvert-kde.png"    "$pkgdir/usr/share/wallpapers/Ouvert/ouvert-kde.png"
    # Bug 47 cosmic: обои COSMIC
    install -Dm644 "$srcdir/ouvert-cosmic.png" "$pkgdir/usr/share/wallpapers/Ouvert/ouvert-cosmic.png"

    # Логотип дистрибутива (для LOGO= в os-release и общего использования)
    install -Dm644 "$srcdir/ouvert-logo.png" "$pkgdir/usr/share/pixmaps/ouvert.png"

    # Ресурсы, на которые ссылаются custom_commands / fastfetch
    install -Dm644 "$srcdir/grub-bg.png"              "$pkgdir/usr/share/ouvert/grub-bg.png"
    install -Dm644 "$srcdir/fastfetch-logo.ansi"      "$pkgdir/usr/share/ouvert/fastfetch-logo.ansi"
    install -Dm644 "$srcdir/fastfetch-logo-ascii.txt" "$pkgdir/usr/share/ouvert/fastfetch-logo-ascii.txt"

    # Конфиг fastfetch для будущих пользователей (новый юзер копирует /etc/skel)
    install -Dm644 "$srcdir/fastfetch-config.jsonc" "$pkgdir/etc/skel/.config/fastfetch/config.jsonc"

    # Bug 47 cosmic: штатный оверрайд cosmic-config.
    # Системный дефолт лежит в /usr/share/cosmic/ и принадлежит пакету
    # cosmic-bg — писать туда НЕЛЬЗЯ (конфликт файлов в pacman и
    # перезапись при -Syu). Пользовательский слой ~/.config/cosmic/
    # ничей, поэтому кладём в /etc/skel. Хук restore-wallpapers.sh
    # здесь не нужен: чужих файлов не трогаем, восстанавливать нечего.
    install -Dm644 "$srcdir/cosmic-bg-all" "$pkgdir/etc/skel/.config/cosmic/com.system76.CosmicBackground/v1/all"
    install -Dm644 "$srcdir/cosmic-bg-backgrounds" "$pkgdir/etc/skel/.config/cosmic/com.system76.CosmicBackground/v1/backgrounds"

    # pacman-хук: обновление xfdesktop / plasma-workspace-wallpapers
    # затирает наши обои штатными. Триггер ПО ПУТЯМ, а не по имени
    # пакета: имена в Arch переезжают, путь — нет.
    install -Dm644 "$srcdir/ouvert-wallpapers.hook" "$pkgdir/usr/share/libalpm/hooks/ouvert-wallpapers.hook"
    install -Dm755 "$srcdir/ouvert-restore-wallpapers.sh" "$pkgdir/usr/share/ouvert/restore-wallpapers.sh"
    # Текст лицензии: license=(LicenseRef-*) обязывает положить
    # файл в /usr/share/licenses/$pkgname/ — иначе namcap даёт E.
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
