{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/usr/share/ouvert/fastfetch-logo.ansi",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " → "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "ОС"
    },
    {
      "type": "kernel",
      "key": "Ядро"
    },
    {
      "type": "uptime",
      "key": "Аптайм"
    },
    {
      "type": "packages",
      "key": "Пакеты"
    },
    {
      "type": "shell",
      "key": "Оболочка"
    },
    {
      "type": "de",
      "key": "Среда"
    },
    {
      "type": "wm",
      "key": "ОМ"
    },
    {
      "type": "terminal",
      "key": "Терминал"
    },
    {
      "type": "cpu",
      "key": "ЦП"
    },
    {
      "type": "gpu",
      "key": "ГП"
    },
    {
      "type": "memory",
      "key": "ОЗУ"
    },
    {
      "type": "swap",
      "key": "Подкачка"
    },
    {
      "type": "disk",
      "key": "Диск"
    },
    "break",
    "colors"
  ]
}
